---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{% for l in site.languages %}  <url>
    <loc>{{ site.url }}/{{ l }}/</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>{% for alt in site.languages %}
    <xhtml:link rel="alternate" hreflang="{{ alt }}" href="{{ site.url }}/{{ alt }}/"/>{% endfor %}
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ site.url }}/en/"/>
  </url>
{% endfor %}{% for p in site.pages %}{% if p.layout == "section" %}  <url>
    <loc>{{ site.url }}{{ p.url }}</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
  </url>
{% endif %}{% endfor %}</urlset>
