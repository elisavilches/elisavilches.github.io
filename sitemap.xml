---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{% for l in site.languages %}  <url>
    <loc>{{ site.url }}/{{ l }}/</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>{% for alt in site.languages %}
    <xhtml:link rel="alternate" hreflang="{{ alt }}" href="{{ site.url }}/{{ alt }}/"/>{% endfor %}
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ site.url }}/en/"/>
  </url>
{% endfor %}{% assign ref_pages = site.pages | where_exp: "p", "p.ref" %}{% for p in ref_pages %}{% if p.robots contains "noindex" %}{% continue %}{% endif %}  <url>
    <loc>{{ site.url }}{{ p.url }}</loc>
    <lastmod>{{ p.last_updated | default: site.time | date_to_xmlschema }}</lastmod>{% assign versions = site.pages | where: "ref", p.ref %}{% for v in versions %}
    <xhtml:link rel="alternate" hreflang="{{ v.lang }}" href="{{ site.url }}{{ v.url }}"/>{% endfor %}
  </url>
{% endfor %}{% for p in site.pages %}{% if p.layout == "section" and p.url != "/work/" %}  <url>
    <loc>{{ site.url }}{{ p.url }}</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
  </url>
{% endif %}{% endfor %}</urlset>
